CUPLOCK_ENV=dev
CUPLOCK_DATABASE_URL=postgresql+psycopg://cuplock:cuplock@localhost:5432/cuplock
CUPLOCK_JWT_SECRET=change-me-to-a-long-random-string
CUPLOCK_OTP_SECRET=change-me-to-another-long-random-string
# console (dev only, OTP shown in API log as "dev outbox") | email | sms
CUPLOCK_OTP_DELIVERY=console
CUPLOCK_OWNER_USERNAME=owner
CUPLOCK_OWNER_PASSWORD=Owner@12345
CUPLOCK_OWNER_PHONE=9000000000
CUPLOCK_OWNER_EMAIL=owner@example.com
# For email OTP
CUPLOCK_SMTP_HOST=
CUPLOCK_SMTP_PORT=587
CUPLOCK_SMTP_USER=
CUPLOCK_SMTP_PASSWORD=
CUPLOCK_SMTP_FROM=
